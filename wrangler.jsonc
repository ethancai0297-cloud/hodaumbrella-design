{
  // Cloudflare Workers config: serve the Vite build output (dist/) as a static
  // single-page app. The name must match the Worker name in the dashboard.
  "name": "hodaumbrella-design",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
